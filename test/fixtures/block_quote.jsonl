{"file":"block_quote","input":"> # a\n> b\nc","ok":"<blockquote>\n<h1>a</h1>\n<p>b\nc</p>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should support lazy content lines","t":"assert","test":"block_quote"}
{"file":"block_quote","input":"> a\nb\n> c","ok":"<blockquote>\n<p>a\nb\nc</p>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should support lazy content lines inside block quotes","t":"assert","test":"block_quote"}
{"file":"block_quote","input":"> a\n> ---","ok":"<blockquote>\n<h2>a</h2>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should support setext headings underlines in block quotes","t":"assert","test":"block_quote"}
