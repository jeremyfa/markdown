{"file":"block_quote","msg":"should not support lazy setext headings underlines in block quotes","t":"assert","test":"block_quote"}
{"file":"block_quote","input":"> - a\n> - b","ok":"<blockquote>\n<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n</blockquote>","t":"html","test":"block_quote"}
