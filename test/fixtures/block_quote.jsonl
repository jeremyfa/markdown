{"file":"block_quote","input":"> # a\n> b\n> c","ok":"<blockquote>\n<h1>a</h1>\n<p>b\nc</p>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should support block quotes","t":"assert","test":"block_quote"}
{"file":"block_quote","input":"># a\n>b\n> c","ok":"<blockquote>\n<h1>a</h1>\n<p>b\nc</p>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should support block quotes w/o space","t":"assert","test":"block_quote"}
{"file":"block_quote","input":"   > # a\n   > b\n > c","ok":"<blockquote>\n<h1>a</h1>\n<p>b\nc</p>\n</blockquote>","t":"html","test":"block_quote"}
