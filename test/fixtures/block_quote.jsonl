{"file":"block_quote","input":"> a\n```\nb","ok":"<blockquote>\n<p>a</p>\n</blockquote>\n<pre><code>b\n</code></pre>\n","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should not support lazy fenced code in block quotes (2)","t":"assert","test":"block_quote"}
{"file":"block_quote","input":"> a\n    - b","ok":"<blockquote>\n<p>a\n- b</p>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should not support lazy indented code (or lazy list) in block quotes","t":"assert","test":"block_quote"}
