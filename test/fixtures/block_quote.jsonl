{"file":"block_quote","input":"> a\nb","ok":"<blockquote>\n<p>a\nb</p>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should not support interrupting block quotes w/ paragraphs","t":"assert","test":"block_quote"}
{"file":"block_quote","input":"> a\n\nb","ok":"<blockquote>\n<p>a</p>\n</blockquote>\n<p>b</p>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should support interrupting block quotes w/ blank lines","t":"assert","test":"block_quote"}
{"file":"block_quote","input":"> a\n>\nb","ok":"<blockquote>\n<p>a</p>\n</blockquote>\n<p>b</p>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should not support interrupting a blank line in a block quotes w/ paragraphs","t":"assert","test":"block_quote"}
{"file":"block_quote","input":"> > > a\nb","ok":"<blockquote>\n<blockquote>\n<blockquote>\n<p>a\nb</p>\n</blockquote>\n</blockquote>\n</blockquote>","t":"html","test":"block_quote"}
