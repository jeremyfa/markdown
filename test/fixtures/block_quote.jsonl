{"file":"block_quote","msg":"should support a definition, followed by a lazy paragraph","t":"assert","test":"block_quote"}
{"file":"block_quote","input":">","ok":"<blockquote>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should support empty block quotes (1)","t":"assert","test":"block_quote"}
{"file":"block_quote","input":">\n>  \n> ","ok":"<blockquote>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should support empty block quotes (2)","t":"assert","test":"block_quote"}
