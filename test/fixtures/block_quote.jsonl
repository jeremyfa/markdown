{"file":"block_quote","input":">>> a\n> b\n>>c","ok":"<blockquote>\n<blockquote>\n<blockquote>\n<p>a\nb\nc</p>\n</blockquote>\n</blockquote>\n</blockquote>","t":"html","test":"block_quote"}
