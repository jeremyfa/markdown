{"file":"block_quote","input":">     a\n\n>    b","ok":"<blockquote>\n<pre><code>a\n</code></pre>\n</blockquote>\n<blockquote>\n<p>b</p>\n</blockquote>","t":"html","test":"block_quote"}
{"file":"block_quote","msg":"should support 5 spaces for indented code, not 4","t":"assert","test":"block_quote"}
