{"file":"image","input":"[link](/uri \"title\")","ok":"<p><a href=\"/uri\" title=\"title\">link</a></p>","t":"html","test":"image"}
{"file":"image","msg":"should support links","t":"assert","test":"image"}
{"file":"image","input":"![foo](/url \"title\")","ok":"<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support image w/ resource","t":"assert","test":"image"}
{"file":"image","input":"[foo *bar*]: train.jpg \"train & tracks\"\n\n![foo *bar*]","ok":"<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support image as shortcut reference","t":"assert","test":"image"}
{"file":"image","input":"![foo ![bar](/url)](/url2)","ok":"<p><img src=\"/url2\" alt=\"foo bar\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should \u201csupport\u201d images in images","t":"assert","test":"image"}
{"file":"image","input":"![foo [bar](/url)](/url2)","ok":"<p><img src=\"/url2\" alt=\"foo bar\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should \u201csupport\u201d links in images","t":"assert","test":"image"}
{"file":"image","input":"[foo *bar*]: train.jpg \"train & tracks\"\n\n![foo *bar*][]","ok":"<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support \u201ccontent\u201d in images","t":"assert","test":"image"}
{"file":"image","input":"[FOOBAR]: train.jpg \"train & tracks\"\n\n![foo *bar*][foobar]","ok":"<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support \u201ccontent\u201d in images","t":"assert","test":"image"}
{"file":"image","input":"![foo](train.jpg)","ok":"<p><img src=\"train.jpg\" alt=\"foo\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/o title","t":"assert","test":"image"}
{"file":"image","input":"My ![foo bar](/path/to/train.jpg  \"title\"   )","ok":"<p>My <img src=\"/path/to/train.jpg\" alt=\"foo bar\" title=\"title\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/ lots of whitespace","t":"assert","test":"image"}
{"file":"image","input":"![foo](<url>)","ok":"<p><img src=\"url\" alt=\"foo\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/ enclosed destinations","t":"assert","test":"image"}
{"file":"image","input":"![](/url)","ok":"<p><img src=\"/url\" alt=\"\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/ empty labels","t":"assert","test":"image"}
{"file":"image","input":"[bar]: /url\n\n![foo][bar]","ok":"<p><img src=\"/url\" alt=\"foo\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support full references (1)","t":"assert","test":"image"}
{"file":"image","input":"[BAR]: /url\n\n![foo][bar]","ok":"<p><img src=\"/url\" alt=\"foo\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support full references (2)","t":"assert","test":"image"}
{"file":"image","input":"[foo]: /url \"title\"\n\n![foo][]","ok":"<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support collapsed references (1)","t":"assert","test":"image"}
{"file":"image","input":"[*foo* bar]: /url \"title\"\n\n![*foo* bar][]","ok":"<p><img src=\"/url\" alt=\"foo bar\" title=\"title\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support collapsed references (2)","t":"assert","test":"image"}
{"file":"image","input":"[foo]: /url \"title\"\n\n![Foo][]","ok":"<p><img src=\"/url\" alt=\"Foo\" title=\"title\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support case-insensitive labels","t":"assert","test":"image"}
{"file":"image","input":"[foo]: /url \"title\"\n\n![foo] \n[]","ok":"<p><img src=\"/url\" alt=\"foo\" title=\"title\" />\n[]</p>","t":"html","test":"image"}
{"file":"image","msg":"should not support whitespace between sets of brackets","t":"assert","test":"image"}
{"file":"image","input":"[foo]: /url \"title\"\n\n![foo]","ok":"<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support shortcut references (1)","t":"assert","test":"image"}
{"file":"image","input":"[*foo* bar]: /url \"title\"\n\n![*foo* bar]","ok":"<p><img src=\"/url\" alt=\"foo bar\" title=\"title\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support shortcut references (2)","t":"assert","test":"image"}
{"file":"image","input":"[[foo]]: /url \"title\"\n\n![[foo]]","ok":"<p>[[foo]]: /url &quot;title&quot;</p>\n<p>![[foo]]</p>","t":"html","test":"image"}
{"file":"image","msg":"should not support link labels w/ unescaped brackets","t":"assert","test":"image"}
{"file":"image","input":"[foo]: /url \"title\"\n\n![Foo]","ok":"<p><img src=\"/url\" alt=\"Foo\" title=\"title\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support case-insensitive label matching","t":"assert","test":"image"}
{"file":"image","input":"[foo]: /url \"title\"\n\n!\\[foo]","ok":"<p>![foo]</p>","t":"html","test":"image"}
{"file":"image","msg":"should \u201csupport\u201d an escaped bracket instead of an image","t":"assert","test":"image"}
{"file":"image","input":"[foo]: /url \"title\"\n\n\\![foo]","ok":"<p>!<a href=\"/url\" title=\"title\">foo</a></p>","t":"html","test":"image"}
{"file":"image","msg":"should support an escaped bang instead of an image, but still have a link","t":"assert","test":"image"}
{"file":"image","input":"![foo]()","ok":"<p><img src=\"\" alt=\"foo\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/o destination","t":"assert","test":"image"}
{"file":"image","input":"![foo](<>)","ok":"<p><img src=\"\" alt=\"foo\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/ explicit empty destination","t":"assert","test":"image"}
{"file":"image","input":"![](example.png)","ok":"<p><img src=\"example.png\" alt=\"\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/o alt","t":"assert","test":"image"}
{"file":"image","input":"![alpha](bravo.png \"\")","ok":"<p><img src=\"bravo.png\" alt=\"alpha\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/ empty title (1)","t":"assert","test":"image"}
{"file":"image","input":"![alpha](bravo.png '')","ok":"<p><img src=\"bravo.png\" alt=\"alpha\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/ empty title (2)","t":"assert","test":"image"}
{"file":"image","input":"![alpha](bravo.png ())","ok":"<p><img src=\"bravo.png\" alt=\"alpha\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support images w/ empty title (3)","t":"assert","test":"image"}
{"file":"image","input":"![&amp;&copy;&](example.com/&amp;&copy;& \"&amp;&copy;&\")","ok":"<p><img src=\"example.com/&amp;%C2%A9&amp;\" alt=\"&amp;\u00a9&amp;\" title=\"&amp;\u00a9&amp;\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should support character references in images","t":"assert","test":"image"}
{"file":"image","input":"![](<> \"\")","ok":"<p><img src=\"\" alt=\"\" /></p>","t":"html","test":"image"}
{"file":"image","msg":"should ignore an empty title","t":"assert","test":"image"}
